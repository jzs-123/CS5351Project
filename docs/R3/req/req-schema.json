{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R3 requirements register",
  "type": "object",
  "required": [
    "version",
    "scope",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "priority",
          "statement",
          "source",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R3-[FIQCG][0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "functional",
              "safety",
              "quality",
              "cost",
              "governance"
            ]
          },
          "priority": {
            "enum": [
              "Must",
              "Should",
              "Could",
              "Won't"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "criterion",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
